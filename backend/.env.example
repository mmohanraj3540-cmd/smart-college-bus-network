# Application Configuration
PROJECT_NAME="Smart College Bus Network"
JWT_SECRET=super_secret_jwt_key_for_development_only_12345
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (no trailing slashes):
# Example: https://your-frontend-domain.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Database Configuration
# Default (local SQLite - preserves existing tables & data):
DATABASE_URL=sqlite:///./sql_app.db

# To use PostgreSQL (e.g. Supabase, Neon, Render Postgres):
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# To use MySQL:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>

# Map and Tracking Settings
MAP_PROVIDER=leaflet
MAP_API_KEY=
GPS_UPDATE_INTERVAL=7000
GPS_STATIONARY_INTERVAL=15000
STALE_LOCATION_THRESHOLD=30000
MAX_ALTERNATIVE_STOP_DISTANCE=1000
