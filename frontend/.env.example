# Frontend Environment Configuration

# Deployed Backend API URL (HTTP / HTTPS)
# Example: https://smart-bus-backend.onrender.com/api
# For local development, leave empty to default to http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Optional: Dedicated WebSocket URL (WS / WSS)
# If left empty, it automatically derives ws:// or wss:// from VITE_API_URL
# Example: wss://smart-bus-backend.onrender.com
# VITE_WS_URL=
